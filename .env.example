# ===========================================
# Aikiz International CRM - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# DATABASE (Required - Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host-direct/database?sslmode=require

# AUTH (Required)
NEXTAUTH_SECRET=generate-a-random-32-char-string-here
# Do NOT set NEXTAUTH_URL on Netlify - it auto-detects

# SMTP EMAIL (Required for email features)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM_NAME=Matthews & Associates

# Per-account SMTP credentials
SMTP_CONSENT_USER=consent@matthewsassociate.com
SMTP_CONSENT_PASS=your-password-here
SMTP_CLAIMS_USER=claims@matthewsassociate.com
SMTP_CLAIMS_PASS=your-password-here
SMTP_INFO_USER=info@matthewsassociate.com
SMTP_INFO_PASS=your-password-here

# OPTIONAL
UPLOAD_DIR=/tmp/crm-uploads
NODE_ENV=production
