# ===========================================
# Aikiz CRM - Production Environment Variables
# ===========================================
# Copy this file as .env.production on your host
# and fill in the values

# --- Database (PostgreSQL) ---
# Get a FREE database at:
#   Neon: https://neon.tech (free tier: 0.5 GB)
#   Supabase: https://supabase.com (free tier: 500 MB)
#   Railway: https://railway.app (free $5 credit/month)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- NextAuth ---
NEXTAUTH_SECRET=generate-a-random-string-here-use-openssl-rand-base64-32
NEXTAUTH_URL=https://your-app-name.railway.app

# --- App ---
NODE_ENV=production
PORT=3000

# --- Secure uploaded records ---
# Set this to a persistent, private volume mounted by your host. Do not use a
# public web directory. The default /tmp folder is only suitable for local tests.
UPLOAD_DIR=/data/crm-uploads
